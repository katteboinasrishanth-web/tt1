    {
      "name": "07 · Cancel & logout",
      "item": [
        {
          "name": "Customer cancels own booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/mine/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "mine", "{{reservationId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelled booking frees the tables again",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/tables/combos?date={{bookDate}}&time={{bookTime}}&numberOfPeople={{partySize}}&occasion={{occasion}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tables", "combos"],
              "query": [
                { "key": "date", "value": "{{bookDate}}" },
                { "key": "time", "value": "{{bookTime}}" },
                { "key": "numberOfPeople", "value": "{{partySize}}" },
                { "key": "occasion", "value": "{{occasion}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "const ids = String(pm.environment.get('bookTableIds')).split(',');",
                  "pm.test('freed tables are suggested again', () => {",
                  "  const freed = list.some((s) => s.tableIds.every((id) => ids.includes(String(id))));",
                  "  pm.expect(freed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
