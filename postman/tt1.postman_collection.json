            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"MAYBE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/reservations/{{reservationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "reservations", "{{reservationId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prep board (ordered by prep-ready time)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": {
              "raw": "{{baseUrl}}/api/admin/prep-board?date={{bookDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "prep-board"],
              "query": [{ "key": "date", "value": "{{bookDate}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const board = pm.response.json();",
                  "pm.test('confirmed booking shows up', () => {",
                  "  const id = Number(pm.environment.get('reservationId'));",
                  "  pm.expect(board.tasks.some((t) => t.reservationId === id)).to.be.true;",
                  "});",
                  "pm.test('occasion counted', () => pm.expect(board.occasionCount).to.be.above(0));",
                  "pm.test('sorted by prep ready time', () => {",
                  "  const times = board.tasks.map((t) => t.prepReadyTime);",
                  "  pm.expect(times).to.eql([...times].sort());",
                  "});",
                  "console.log('prep board:', board.taskCount, 'tasks,', board.occasionCount, 'occasions');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 · Admin table CRUD",
      "item": [
        {
          "name": "Create table",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.environment.set('newTableNumber', `P${Math.floor(Math.random() * 9000 + 1000)}`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('number echoed', () => pm.expect(t.tableNumber).to.eql(pm.environment.get('newTableNumber')));",
                  "pm.environment.set('createdTableId', String(t.tableId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
